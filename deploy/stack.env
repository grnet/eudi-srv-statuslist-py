# Non-secret deploy configuration, committed so it is reviewable in a diff.
# Secrets are repository secrets and are listed in deploy/README.md.

STATUSLIST_HOST=demo.eudiw.grnet.gr

# Signed into every token as `sub`. No port, because behind the proxy the name
# arrives on 443.
#
# The trailing slash is required, not cosmetic. list_management.py concatenates
# this with a path, and identifier_list_format.py takes service_url[:-1] for the
# `iss` claim, chopping the last character unconditionally. Without the slash
# every URI loses its separator and `iss` loses a real character.
#
# Tokens issued before this change carry :5603 inside the signature and stop
# resolving. Accepted: development data, expiring 2026-12-07.
SERVICE_URL=https://demo.eudiw.grnet.gr/

LETSENCRYPT_EMAIL=devops-rnd@grnet.gr

# Where the signing key and certificate sit on the EC2 box. Absolute path: this
# is a bind mount resolved on the remote filesystem, and the directory must
# exist with signing.key and signing.der in it before the first deploy.
SIGNING_KEY_DIR=/home/ubuntu/statuslist-keys
